# Generate each secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=replace-with-a-random-secret-at-least-32-characters
TOKEN_SIGNING_KEY=replace-with-a-different-random-secret-at-least-32-characters
CATALOG_NAME=warehouse
# For Railway, use a reference to the Postgres DATABASE_URL.
DATABASE_URL=postgresql://polaris:local-development-only@postgres:5432/polaris
S3_BUCKET=warehouse
S3_ENDPOINT=http://storage:5000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-test-key
AWS_SECRET_ACCESS_KEY=local-test-secret
S3_PATH_STYLE_ACCESS=true
PUBLIC_URL=http://localhost:8080
